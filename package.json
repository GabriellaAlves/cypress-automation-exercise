{
  "name": "cypress-automation-exercise",
  "version": "1.0.0",
  "private": true,
  "description": "UI automation for Automation Exercise using Cypress and Mochawesome",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
    "report:merge": "mochawesome-merge cypress/reports/*.json -o cypress/reports/report.json",
    "report:generate": "marge cypress/reports/report.json --reportDir cypress/reports/html --inline",
    "report": "npm run report:merge && npm run report:generate"
  },
  "devDependencies": {
    "cypress": "^14.5.0",
    "cypress-mochawesome-reporter": "^3.8.2",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}